{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otahub",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ADMIN_KV",
      "id": "6a6a257b47e845e59908fee8d25dd199"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEWS_DB",
      "database_name": "otahub-news",
      "database_id": "6632742c-7021-484c-ac67-72559f50d765",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["17 */2 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
