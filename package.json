{
  "name": "otahub-source",
  "version": "2.0.0",
  "description": "OtaHub.asia - Comprehensive Anime, Gaming & Pop-Culture Portal",
  "type": "module",
  "scripts": {
    "publish": "node scripts/publish-article.mjs",
    "ping": "node scripts/ping-indexnow.mjs",
    "audit": "node scripts/live-audit.mjs",
    "authors:build": "node scripts/generate-author-profiles.mjs",
    "indexes:build": "node scripts/normalize-publishing-data.mjs && node scripts/generate-author-profiles.mjs && node scripts/rebuild-discovery-indexes.mjs",
    "content:clean-dashes": "node scripts/remove-em-dashes.mjs",
    "news:db:local": "wrangler d1 migrations apply otahub-news --local",
    "news:db:remote": "wrangler d1 migrations apply otahub-news --remote",
    "news:dev": "wrangler dev --test-scheduled",
    "deploy:check": "node scripts/audit-public-html-safety.mjs && wrangler deploy --dry-run"
  },
  "author": "OtaHub Team",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "wrangler": "^4.136.3"
  }
}
